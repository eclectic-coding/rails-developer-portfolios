<%# locals: (portfolios:, letter: nil, query: nil) %>
<% cache ['portfolios_cards', letter, query, Rails.cache.fetch('portfolios_version') { 1 }, portfolios.cache_key_with_version] do %>
  <% if portfolios.present? %>
    <div class="row g-4">
      <% portfolios.each do |portfolio| %>
        <div class="col-sm-6 col-md-4 col-lg-3">
          <%= render 'portfolios/card', portfolio: portfolio %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-info text-center">
      <h4><%= t(".empty_title") %></h4>
      <p><%= t(".empty_description_html") %></p>
    </div>
  <% end %>
<% end %>
