<%# locals: (portfolio:) %>
<div class="card h-100 shadow-sm hover-card">
  <% if portfolio.path.present? %>
    <%= link_to portfolio.path, target: '_blank', rel: 'noopener noreferrer', class: 'text-decoration-none stretched-link' do %>
      <% if portfolio.site_screenshot.attached? %>
        <%= image_tag portfolio.site_screenshot.variant(resize_to_fill: [1280, 450]), class: "card-img-top", alt: t(".screenshot_alt", name: portfolio.name) %>
      <% else %>
        <%= image_tag "default_portfolio_screenshot.svg", class: "card-img-top", alt: t(".default_screenshot_alt") %>
      <% end %>

      <div class="card-body">
        <h5 class="card-title text-dark"><%= portfolio.name %></h5>
        <% if portfolio.tagline.present? %>
          <p class="card-text text-muted small mb-0"><%= portfolio.tagline %></p>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <% if portfolio.site_screenshot.attached? %>
      <%= image_tag portfolio.site_screenshot.variant(resize_to_fill: [1280, 450]), class: "card-img-top", alt: t(".screenshot_alt", name: portfolio.name) %>
    <% else %>
      <%= image_tag "default_portfolio_screenshot.svg", class: "card-img-top", alt: t(".default_screenshot_alt") %>
    <% end %>

    <div class="card-body">
      <h5 class="card-title text-muted"><%= portfolio.name %></h5>
      <% if portfolio.tagline.present? %>
        <p class="card-text text-muted small mb-0"><%= portfolio.tagline %></p>
      <% end %>
    </div>
  <% end %>
</div>
