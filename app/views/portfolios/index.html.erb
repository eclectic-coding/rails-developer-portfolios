<div class="container mt-5">
  <div class="text-center mb-5">
    <h1 class="display-4"><%= t(".title") %></h1>
    <p class="lead text-muted">
      <%= t(".description_html", count: @pagy.count) %>
    </p>
    <small><%= t(".source_html", url: "https://github.com/emmabostian/developer-portfolios", repo: "emmabostian/developer-portfolios") %></small>
  </div>

  <%= render "portfolios/letter_filters", query: @query, letter: @letter %>

  <turbo-frame id="portfolios_cards">
    <%= render 'portfolios/portfolio_cards', portfolios: @portfolios, letter: @letter, query: @query %>

    <div id="infinite-scroll" data-controller="infinite-scroll">
      <div id="portfolios_stream"></div>

      <div id="sentinel-container"
           data-next-page-url="<%= @pagy.next ? portfolios_path(page: @pagy.next, q: @query, letter: @letter) : '' %>">
        <% if @pagy.next %>
          <div data-infinite-scroll-target="sentinel" class="text-center py-4">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden"><%= t(".loading") %></span>
            </div>
          </div>
        <% else %>
          <div class="text-center py-4 text-muted">
            <small><%= t(".end_of_list") %></small>
          </div>
        <% end %>
      </div>
    </div>
  </turbo-frame>
</div>
